# ========================
# ROS 2 核心编译产物
# ========================
# colcon build 自动生成的目录，绝对不能上传
build/
install/
log/

# ========================
# C++ / CMake 编译中间文件
# ========================
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
*.o
*.a
compile_commands.json

# ========================
# Python 相关缓存（ROS2节点常用）
# ========================
__pycache__/
*.pyc

# ========================
# 通用临时和日志文件
# ========================
*.log
*.tmp
.DS_Store
Thumbs.db

# ========================
# IDE 和编辑器配置
# ========================
.vscode/
.idea/
*.iml
*.user
*.autosave

